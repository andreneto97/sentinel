{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "gitleaks",
     "semanticVersion": "v8.0.0",
     "informationUri": "https://github.com/gitleaks/gitleaks",
     "rules": [
      {
       "id": "github-pat",
       "shortDescription": {
        "text": "Uncovered a GitHub Personal Access Token, potentially leading to unauthorized repository access and sensitive content exposure."
       }
      },
      {
       "id": "private-key",
       "shortDescription": {
        "text": "Identified a Private Key, which may compromise cryptographic security and sensitive data encryption."
       }
      }
     ]
    }
   },
   "results": [
    {
     "message": {
      "text": "private-key has detected secret for file src/key.pem at commit aaaa1111bbbb2222cccc3333dddd4444eeee5555."
     },
     "ruleId": "private-key",
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "src/key.pem"
        },
        "region": {
         "startLine": 1,
         "startColumn": 1,
         "endLine": 4,
         "endColumn": 30,
         "snippet": {
          "text": "REDACTED"
         }
        }
       }
      }
     ],
     "partialFingerprints": {
      "commitSha": "aaaa1111bbbb2222cccc3333dddd4444eeee5555",
      "email": "dev@example.com",
      "author": "Dev Example",
      "date": "2026-09-22T19:12:03Z",
      "commitMessage": "chore: add key"
     },
     "properties": {
      "tags": []
     }
    },
    {
     "message": {
      "text": "github-pat has detected secret for file .env at commit 5555eeee4444dddd3333cccc2222bbbb1111aaaa."
     },
     "ruleId": "github-pat",
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".env"
        },
        "region": {
         "startLine": 1,
         "startColumn": 14,
         "endLine": 1,
         "endColumn": 53,
         "snippet": {
          "text": "REDACTED"
         }
        }
       }
      }
     ],
     "partialFingerprints": {
