          "text": "process.env.NODE_TLS_REJECT_UNAUTHORIZED = \"0\";"
         },
         "startColumn": 1,
         "startLine": 23
        }
       }
      }
     ],
     "message": {
      "text": "TLS certificate verification is switched off. Every outbound HTTPS call from this process now accepts any certificate, so anything on the network path can read and rewrite the traffic -- including the calls that carry API keys. If a self-signed certificate is the reason, pin that CA instead with `NODE_EXTRA_CA_CERTS` or an explicit `ca` option."
     },
     "properties": {},
     "ruleId": "delivery.node.tls-verification-disabled"
