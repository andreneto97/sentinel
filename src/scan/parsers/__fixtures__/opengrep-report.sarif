         "endLine": 4,
         "snippet": {
          "text": "  <div v-html=\"post.body\"></div>"
         },
         "startColumn": 7,
         "startLine": 4
        }
       }
      }
     ],
     "message": {
      "text": "`v-html` renders its expression as raw HTML, bypassing Vue's escaping. If the bound value carries anything a user can influence, the markup in it -- including `<script>` and `onerror` attributes -- runs in the visitor's session. Bind with `{{ }}` for text, or sanitise the HTML before binding."
     },
     "properties": {},
     "ruleId": "appsec.xss.vue-v-html"
    },
