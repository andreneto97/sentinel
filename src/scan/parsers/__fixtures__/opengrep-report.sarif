        "region": {
         "endColumn": 62,
         "endLine": 46,
         "snippet": {
          "text": "  res.cookie(\"session\", req.body.token, { maxAge: 86400000 });"
         },
         "startColumn": 3,
         "startLine": 46
        }
       }
      }
     ],
     "message": {
      "text": "A cookie is set without the full flag set. Without `httpOnly` any script on the page can read it, which turns one XSS into stolen sessions; without `secure` it travels over plain HTTP; without `sameSite` it is attached to cross-site requests, which is what makes CSRF work. Set `{ httpOnly: true, secure: true, sameSite: \"lax\" }` on session cookies."
     },
     "properties": {},
     "ruleId": "appsec.auth.insecure-cookie-flags"
    },
