         "endColumn": 66,
         "endLine": 9,
         "snippet": {
          "text": "  return db.query(`SELECT * FROM users WHERE email = '${email}'`);"
         },
         "startColumn": 10,
         "startLine": 9
        }
       }
      }
     ],
     "message": {
      "text": "A SQL statement is assembled by string interpolation or concatenation and then executed. Any value that reaches the interpolated expression becomes part of the statement, so a crafted input can read, change or delete rows the caller was never allowed to touch. Pass the values as parameters (`query(text, [values])`, a tagged template, or the ORM's builder) instead of building the string."
     },
     "properties": {},
     "ruleId": "appsec.injection.sql-built-from-variables"
