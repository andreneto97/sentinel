        },
        "region": {
         "endColumn": 30,
         "endLine": 7,
         "snippet": {
          "text": "  el.innerHTML = comment.body;"
         },
         "startColumn": 3,
         "startLine": 7
        }
       }
      }
     ],
     "message": {
      "text": "A value is written into the DOM as markup (`innerHTML` / `outerHTML` / `insertAdjacentHTML`), so the browser parses it as HTML instead of displaying it as text. Any user-controlled fragment in that value can inject script that runs with the visitor's session. Use `textContent` when the value is text, or sanitise it with DOMPurify when it really has to be HTML."
     },
     "properties": {},
     "ruleId": "appsec.xss.inner-html-assignment"
    }
