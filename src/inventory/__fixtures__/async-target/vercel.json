{
  "crons": [
    { "path": "/api/cron/rotate", "schedule": "0 3 * * *" },
    { "path": "/api/cron/digest", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/missing", "schedule": "0 0 * * 0" }
  ],
  "functions": {
    "app/api/cron/digest/route.ts": { "memory": 3008, "maxDuration": 300 }
  }
}
